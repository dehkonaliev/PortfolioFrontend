user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log;
    sendfile on;
    keepalive_timeout 65;
    server_tokens off;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Detect social-media crawlers / link-preview bots that don't run JavaScript.
    map $http_user_agent $crawler {
        default 0;
        "~*TelegramBot" 1;
        "~*facebookexternalhit" 1;
        "~*facebookcatalog" 1;
        "~*Twitterbot" 1;
        "~*twitterexternalhit" 1;
        "~*LinkedInBot" 1;
        "~*Slackbot" 1;
        "~*Discordbot" 1;
        "~*WhatsApp" 1;
        "~*vkShare" 1;
        "~*Pinterest" 1;
        "~*redditbot" 1;
        "~*XING-Preview" 1;
        "~*Pocket" 1;
        "~*baiduspider" 1;
        "~*bingbot" 1;
        "~*Googlebot" 1;
        "~*Google-InspectionTool" 1;
        "~*Applebot" 1;
        "~*rogerbot" 1;
        "~*embedly" 1;
        "~*quora link preview" 1;
        "~*showyoubot" 1;
        "~*tumblr" 1;
        "~*skypeuripreview" 1;
        "~*flipboard" 1;
        "~*bitlybot" 1;
        "~*nuzzel" 1;
        "~*outbrain" 1;
        "~*duckduckbot" 1;
        "~*yandex" 1;
        "~*bytespider" 1;
        "~*amazonbot" 1;
        "~*Slurp" 1;
        "~*curl" 1;
    }

    server {
        listen 80;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        charset utf-8;

        # --- API and media are forwarded to the Django backend ---
        location /api/ {
            proxy_pass ${BACKEND_HOST}/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /media/ {
            proxy_pass ${BACKEND_HOST}/media/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # --- SPA with crawler prerendering ---
        location / {
            set $prerender 0;
            if ($crawler = 1) { set $prerender 1; }
            if ($args ~ "_escaped_fragment_") { set $prerender 1; }
            if ($prerender = 1) { rewrite ^ /__prerender$request_uri last; }
            try_files $uri $uri/ /index.html;
        }

        # Crawlers are served a pre-rendered HTML page from the backend
        # that carries the correct Open Graph / Twitter meta tags.
        location ~ ^/__prerender(.*)$ {
            internal;
            proxy_pass ${BACKEND_HOST}$1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}